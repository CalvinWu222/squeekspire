{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/leaderboard", "destination": "/index.html" },
    { "source": "/leaderboard/", "destination": "/index.html" }
  ],
  "functions": {
    "api/*.ts": {
      "includeFiles": "{fixtures,public/data,server,src/game}/**"
    }
  }
}
